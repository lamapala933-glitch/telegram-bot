import asyncio
from aiogram import Bot, Dispatcher, F, types
from aiogram.filters import CommandStart
from playwright.async_api import async_playwright

TOKEN = "8746874369:AAHsPG3lsRYOE0D43xrwUim9gpDwRTHW2AI"

dp = Dispatcher()
bot = Bot(token=TOKEN)

@dp.message(CommandStart())
async def cmd_start(message: types.Message):
    await message.answer("Привет! Отправь мне ссылку, а я подожду таймер и пришлю ключ.")

@dp.message(F.text.startswith("http"))
async def handle_link(message: types.Message):
    url = message.text.strip()
    status_msg = await message.answer("⏳ Обрабатываю ссылку, ждем таймер...")

    key = await bypass_timer_site(url)

    if key:
        await status_msg.edit_text(f"✅ **Готово!**\n\nКлюч: `{key}`", parse_mode="Markdown")
    else:
        await status_msg.edit_text("❌ Не удалось получить ключ. Попробуй позже.")

async def bypass_timer_site(url: str) -> str | None:
    async with async_playwright() as p:
        browser = await p.chromium.launch(headless=True)
        page = await browser.new_page()
        
        try:
            await page.goto(url, timeout=30000)
            await asyncio.sleep(9)
            
            await browser.close()
            return "Пример_ключа_12345" 
        except Exception as e:
            print(f"Ошибка при обходе: {e}")
            await browser.close()
            return None

async def main():
    print("Бот запущен...")
    await dp.start_polling(bot)

if __name__ == "__main__":
    asyncio.run(main())
